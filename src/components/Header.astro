---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="site-name" href="/">{SITE_TITLE}</a>

		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/notebook">Notebook</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
		</div>
		<button class="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false">
			<span class="theme-toggle-icon" aria-hidden="true">
				<span class="theme-icon-sun">☀</span>
				<span class="theme-icon-moon">☾</span>
			</span>
		</button>
	</nav>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
	const root = document.documentElement;
	const preferenceKey = 'theme-preference';

	const getTheme = () => {
		const savedTheme = localStorage.getItem(preferenceKey);
		if (savedTheme === 'light' || savedTheme === 'dark') return savedTheme;
		return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
	};

	const updateToggle = (theme: string) => {
		const isDark = theme === 'dark';
		root.dataset.theme = theme;
		toggle?.setAttribute('data-theme', theme);
		toggle?.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
		toggle?.setAttribute('aria-pressed', String(isDark));
	};

	updateToggle(getTheme());

	toggle?.addEventListener('click', () => {
		const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
		localStorage.setItem(preferenceKey, nextTheme);
		updateToggle(nextTheme);
	});
</script>

<style>
	header {
		position: relative;
		margin: 0;
		padding: 0 max(1rem, calc((100vw - var(--content-width)) / 2));
		background: var(--paper);
		border-bottom: 1px solid var(--line);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		min-height: 4.5rem;
	}

	.site-name {
		color: rgb(var(--black));
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		text-decoration: none;
	}

	.site-name:hover {
		color: rgb(var(--black));
	}

	.internal-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		justify-content: flex-end;
	}

	.internal-links a {
		padding: 0.4rem 0;
		color: rgb(var(--gray-dark));
		font-size: 0.88rem;
		font-weight: 600;
		text-decoration: none;
	}

	.internal-links a:hover,
	.internal-links a.active {
		color: var(--accent-dark);
		underline: 2px solid var(--accent);
	}

	.internal-links a.active {
		border-bottom: 2px solid var(--accent);
	}

	.theme-toggle {
		display: grid;
		flex: 0 0 auto;
		place-items: center;
		width: 2.35rem;
		height: 2.35rem;
		padding: 0;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--surface);
		color: var(--accent-dark);
		cursor: pointer;
		transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
	}

	.theme-toggle:hover,
	.theme-toggle:focus-visible {
		border-color: var(--accent);
		background: var(--accent);
		color: var(--paper);
	}

	.theme-toggle:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	.theme-toggle-icon {
		display: block;
		font-size: 1.15rem;
		line-height: 1;
	}

	.theme-icon-sun {
		display: none;
	}

	.theme-icon-moon {
		display: inline;
	}

	.theme-toggle[data-theme='dark'] .theme-icon-sun {
		display: inline;
	}

	.theme-toggle[data-theme='dark'] .theme-icon-moon {
		display: none;
	}

	@media (max-width: 620px) {
		nav {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.75rem;
			padding: 1rem 0;
		}

		.internal-links {
			width: 100%;
			justify-content: flex-start;
		}

		.theme-toggle {
			position: absolute;
			top: 1rem;
			right: 1rem;
		}
	}
</style>
