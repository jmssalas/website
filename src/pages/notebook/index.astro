---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import { SITE_TITLE } from "../../consts";

const entries = (await getCollection("notebook")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={`Engineering Notebook | ${SITE_TITLE}`}
            description="Technical notes on architecture, complex systems, system design and engineering decisions."
        />
        <style>
            .notebook-page {
                padding-top: var(--space-8);
            }

            .notebook-intro {
                padding-bottom: var(--space-5);
            }

            .eyebrow,
            .note-meta {
                color: var(--accent-dark);
                font-size: 0.78rem;
                font-weight: 700;
                letter-spacing: 0.12em;
                text-transform: uppercase;
            }

            .eyebrow {
                margin-bottom: var(--space-4);
            }

            .notebook-intro h1 {
                margin-bottom: var(--space-5);
            }

            .notebook-intro p {
                margin: 0;
                font-size: clamp(1.15rem, 2vw, 1.4rem);
            }

            .notes {
                border-top: 1px solid var(--line);
            }

            .note {
                display: grid;
                grid-template-columns:
                    4rem minmax(0, 1fr)
                    auto;
                gap: var(--space-5);
                align-items: start;
                padding: var(--space-5) 0;
                border-bottom: 1px solid var(--line);
            }

            .note-index {
                margin: 0;
                color: var(--accent-dark);
                font-size: 0.8rem;
                font-variant-numeric: tabular-nums;
                font-weight: 700;
                letter-spacing: 0.08em;
            }

            .note-meta {
                margin: 0;
                font-size: 0.7rem;
            }

            .note h2 {
                margin: 0 0 var(--space-3);
                font-size: clamp(1.5rem, 2.5vw, 2.25rem);
            }

            .note h2 a {
                color: rgb(var(--black));
                text-decoration: none;
            }

            .note h2 a:hover {
                color: var(--accent-dark);
            }

            .note p {
                margin: 0;
                color: var(--muted);
                font-size: 1rem;
            }

            .note-meta + p {
                margin-top: var(--space-3);
            }

            .note-link {
                color: var(--accent-dark);
                font-weight: 700;
                text-decoration: none;
                white-space: nowrap;
            }

            .note-link:hover {
                color: var(--accent);
            }

            .note:hover .note-link {
                text-decoration: underline;
                text-underline-offset: 0.2em;
            }

            @media (max-width: 720px) {
                .notebook-page {
                    padding-top: var(--space-6);
                }

                .note {
                    display: block;
                }

                .note-index {
                    margin-bottom: var(--space-2);
                }

                .note-meta {
                    margin-bottom: var(--space-2);
                }

                .note h2 {
                    margin-bottom: var(--space-2);
                }

                .note-link {
                    display: inline-block;
                    margin-top: var(--space-4);
                }
            }
        </style>
    </head>
    <body>
        <Header />
        <main class="notebook-page">
            <header class="notebook-intro">
                <p class="eyebrow">Engineering Notebook</p>
                <h1>Notes from inside difficult systems.</h1>
                <p>
                    Technical writing about the decisions, constraints and
                    structures behind real engineering work.
                </p>
            </header>

            <section class="notes" aria-label="Notebook entries">
                {
                    entries.map((entry, index) => (
                        <article class="note">
                            <p class="note-index" aria-hidden="true">
                                #{String(entries.length - index).padStart(2, "0")}
                            </p>
                            <div class="note-content">
                                <p class="note-meta">
                                    Engineering note ·{" "}
                                    <FormattedDate date={entry.data.pubDate} />
                                </p>
                                <h2>
                                    <a href={`/notebook/${entry.id}`}>
                                        {entry.data.title}
                                    </a>
                                </h2>
                                <p>{entry.data.description}</p>
                            </div>
                            <a class="note-link" href={`/notebook/${entry.id}`}>
                                Read note &rarr;
                            </a>
                        </article>
                    ))
                }
            </section>
        </main>
        <Footer />
    </body>
</html>
