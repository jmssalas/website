---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_TITLE } from "../consts";

const description =
    "Get in touch with José María Sánchez Salas, Software Engineer and Architect.";
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={`Contact — ${SITE_TITLE}`} description={description} />
    </head>

    <body>
        <Header />

        <main>
            <section class="page-intro">
                <h1>LET'S TALK</h1>

                <p class="lead">
                    If you'd like to get in touch, I'd be happy to hear from
                    you.
                </p>

                <p>
                    Whether you have a project in mind, want to discuss an idea,
                    or simply think we might have something interesting to talk
                    about.
                </p>

                <p>Just introduce yourself and tell me what's on your mind.</p>

                <div class="contact-links">
                    <a href="mailto:josemaria@jmssalas.com">Send me an email</a>

                    <a href="https://linkedin.com/in/jmssalas" target="_blank">
                        Connect on LinkedIn
                    </a>
                </div>
            </section>
        </main>

        <Footer />
    </body>
</html>
