---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_TITLE } from "../consts";

const description =
    "Get in touch to discuss software engineering, complex backend systems, or potential opportunities to work together.";
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={`Contact — ${SITE_TITLE}`} description={description} />
    </head>

    <body>
        <Header />

        <main>
            <section class="contact">
                <h1>LET'S TALK ENGINEERING</h1>

                <p>
                    I'm always interested in discussing complex technical
                    problems, engineering decisions, and how to build better
                    software.
                </p>

                <p>
                    If something I've written resonates with you, you're working
                    on an interesting problem, or you'd like to discuss a
                    professional opportunity, feel free to reach out.
                </p>

                <div class="contact-links">
                    <a href="mailto:josemaria@jmssalas.com">Send me an email</a>

                    <a href="https://linkedin.com/in/jmssalas" target="_blank">
                        Connect on LinkedIn
                    </a>
                </div>
            </section>
        </main>

        <Footer />
    </body>
</html>
